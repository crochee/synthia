use std::sync::Arc;
use synthia_mcp::discovery::ToolDefinition;
use synthia_mcp::manager::McpManager;
use synthia_mcp::tool_adapter::McpToolAdapter;
use synthia_tool::Tool;

fn create_test_adapter() -> Arc<McpToolAdapter> {
    let manager = Arc::new(McpManager::new());
    let tool_definition = ToolDefinition {
        name: "test_tool".to_string(),
        description: "A test MCP tool".to_string(),
        input_schema: serde_json::json!({
            "type": "object",
            "properties": {
                "query": { "type": "string" }
            }
        }),
    };
    Arc::new(McpToolAdapter::new(
        "test-server",
        tool_definition,
        manager,
    ))
}

#[tokio::test]
async fn test_mcp_tool_adapter_not_connected() {
    let adapter = create_test_adapter();

    let input = synthia_tool::types::ToolInput {
        name: "test_tool".to_string(),
        input: serde_json::json!({"query": "test"}),
        context: synthia_tool::types::ToolExecutionContext::new(
            "session1".to_string(),
            std::path::PathBuf::from("/tmp"),
        ),
    };

    let output = adapter.call(input).await;
    assert!(output.is_error.unwrap_or(false));
    let err_msg = output.content[0].text().unwrap();
    assert!(err_msg.contains("not connected") || err_msg.contains("disconnected"));
}

#[tokio::test]
async fn test_mcp_tool_adapter_metadata() {
    let adapter = create_test_adapter();

    assert_eq!(adapter.name(), "test_tool");
    assert_eq!(adapter.description(), "A test MCP tool");
    assert!(adapter.parameters().is_object());
}

#[tokio::test]
async fn test_mcp_tool_adapter_into_mcp_tool() {
    let adapter = create_test_adapter();
    let mcp_tool = adapter.clone().into_mcp_tool();

    assert_eq!(mcp_tool.name(), "test_tool");
    assert_eq!(mcp_tool.server_name(), "test-server");
}

#[tokio::test]
async fn test_mcp_tool_adapter_tool_trait() {
    let adapter = create_test_adapter();

    let input = synthia_tool::types::ToolInput {
        name: "test_tool".to_string(),
        input: serde_json::json!({}),
        context: synthia_tool::types::ToolExecutionContext::new(
            "session1".to_string(),
            std::path::PathBuf::from("/tmp"),
        ),
    };

    let result = adapter.call(input).await;
    assert!(result.is_error.unwrap_or(false));
}

#[tokio::test]
async fn test_multiple_adapters_for_same_server() {
    let manager = Arc::new(McpManager::new());

    let tools = vec![
        ToolDefinition {
            name: "tool_a".to_string(),
            description: "First tool".to_string(),
            input_schema: serde_json::json!({}),
        },
        ToolDefinition {
            name: "tool_b".to_string(),
            description: "Second tool".to_string(),
            input_schema: serde_json::json!({}),
        },
    ];

    let adapters: Vec<Arc<McpToolAdapter>> = tools
        .into_iter()
        .map(|def| Arc::new(McpToolAdapter::new("mock-server", def, manager.clone())))
        .collect();

    assert_eq!(adapters.len(), 2);
    let names: Vec<&str> = adapters.iter().map(|a| a.name()).collect();
    assert!(names.contains(&"tool_a"));
    assert!(names.contains(&"tool_b"));
}