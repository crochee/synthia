# syntax=docker/dockerfile:1.7
#
# Multi-stage Dockerfile for synthia-server (Rust).
# Stage 1: build the release binary
# Stage 2: minimal runtime image

ARG RUST_VERSION=1.95

FROM rust:${RUST_VERSION}-alpine AS builder
RUN apk add --no-cache musl-dev pkgconfig openssl-dev
WORKDIR /app

# Cache dependency layer
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN mkdir -p src && echo "fn main() {}" > src/main.rs \
    && cargo build --release -p synthia-server \
    && rm -rf src

# Build actual binary
COPY . .
RUN cargo build --release -p synthia-server

# ---- Runtime stage ----
FROM alpine:3.19 AS runtime
RUN apk add --no-cache ca-certificates tini
WORKDIR /app

COPY --from=builder /app/target/release/synthia-server /usr/local/bin/synthia-server
COPY config.yaml /app/config.yaml

ENV SYNTHIA_HOST=0.0.0.0 \
    SYNTHIA_PORT=8080 \
    RUST_LOG=info

EXPOSE 8080

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["synthia-server"]
